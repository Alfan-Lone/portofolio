    color:white;
    text-decoration:none;
    font-size:11px;
    font-weight:bold;
    margin-top:20px;
}

.project-link:hover{
    color:#00ff99;
}


/* STATS */

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    border-top:1px solid rgba(255,255,255,.07);
    border-bottom:1px solid rgba(255,255,255,.07);
