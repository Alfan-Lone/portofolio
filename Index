    grid-template-columns:1fr 1fr;
    gap:60px;
}

.about-text p{
    color:#9299a5;
    font-size:14px;
    line-height:1.9;
    margin-bottom:18px;
}

.about-text strong{
    color:white;
}

.about-cards{
    display:flex;
    flex-direction:column;
    gap:14px;
}

.about-card{
    display:flex;
    align-items:center;
    gap:18px;

    padding:20px;

    background:#101319;
    border:1px solid rgba(255,255,255,.07);
    border-radius:15px;

    transition:.3s;
}

.about-card:hover{
    transform:translateX(6px);
    border-color:rgba(0,255,153,.3);
}

.about-icon{
    font-size:25px;
}

.about-card h3{
    font-size:14px;
}

.about-card p{
    color:#777f8b;
    font-size:11px;
    margin-top:3px;
}


/* SKILLS */

.skills{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.skill{
    padding:25px;
    background:#101319;
    border:1px solid rgba(255,255,255,.07);
    border-radius:17px;
    transition:.3s;
}

.skill:hover{
