@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#07090d;
    color:#fff;
    font-family:Inter,Arial,sans-serif;
    overflow-x:hidden;
}

body::before{
    content:"";
    position:fixed;
    width:500px;
    height:500px;
    background:#00ff99;
    opacity:.06;
    filter:blur(150px);
    border-radius:50%;
    top:-250px;
    left:-200px;
    pointer-events:none;
}

body::after{
    content:"";
    position:fixed;
    width:500px;
    height:500px;
    background:#00c8ff;
    opacity:.05;
    filter:blur(150px);
    border-radius:50%;
    right:-250px;
    bottom:-200px;
    pointer-events:none;
}

.container{
    max-width:1100px;
    margin:auto;
    padding:0 25px;
}

/* NAVBAR */

nav{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:70px;
    z-index:1000;

    background:rgba(7,9,13,.75);
    backdrop-filter:blur(15px);

    border-bottom:1px solid rgba(255,255,255,.07);
}

.nav-inner{
    height:70px;
    max-width:1100px;
    margin:auto;
    padding:0 25px;

    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    font-family:"Space Grotesk";
    font-size:21px;
    font-weight:700;
    text-decoration:none;
    color:white;
}

.logo span{
    color:#00ff99;
}

.nav-links{
    display:flex;
    gap:30px;
}

.nav-links a{
    color:#9299a5;
    text-decoration:none;
    font-size:13px;
    transition:.3s;
}

.nav-links a:hover{
    color:#00ff99;
}

.menu{
    display:none;
    color:white;
    font-size:25px;
    cursor:pointer;
}


/* HERO */

.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    padding-top:100px;
}

.hero-grid{
    width:100%;
    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:70px;
    align-items:center;
}

.badge{
    display:inline-flex;
    align-items:center;
    gap:8px;

    padding:8px 13px;
    border:1px solid rgba(0,255,153,.2);
    background:rgba(0,255,153,.04);
    border-radius:50px;

    color:#9ba3ae;
    font-size:11px;
    margin-bottom:25px;
}

.dot{
    width:7px;
    height:7px;
    background:#00ff99;
    border-radius:50%;
    box-shadow:0 0 12px #00ff99;
}

.hero small{
    color:#8d949f;
    letter-spacing:5px;
    font-size:12px;
}

.hero h1{
    font-family:"Space Grotesk";
    font-size:clamp(70px,10vw,120px);
    line-height:.95;
    letter-spacing:-6px;
    margin:5px 0 15px;
}

.hero h1 span{
    color:#00ff99;
}

.hero h2{
    font-size:24px;
    font-weight:500;
}

.hero h2 span{
    color:#00ff99;
}

.description{
    max-width:550px;
    color:#8e96a2;
    font-size:14px;
    line-height:1.8;
    margin-top:20px;
}

.buttons{
    display:flex;
    gap:12px;
    margin-top:30px;
}

.btn{
    padding:13px 20px;
    border-radius:9px;
    text-decoration:none;
    font-size:12px;
    font-weight:700;
    transition:.3s;
}

.primary{
    background:#00ff99;
    color:#00150c;
}

.primary:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 35px rgba(0,255,153,.2);
}

.secondary{
    color:white;
    border:1px solid rgba(255,255,255,.1);
}

.secondary:hover{
    border-color:#00ff99;
    color:#00ff99;
}

.social{
    margin-top:30px;
    display:flex;
    gap:15px;
}

.social a{
    color:#737b87;
    text-decoration:none;
    font-size:11px;
}

.social a:hover{
    color:#00ff99;
}


/* CODE CARD */

.code-card{
    background:#101319;
    border:1px solid rgba(255,255,255,.08);
    border-radius:18px;
    overflow:hidden;

    box-shadow:0 30px 80px rgba(0,0,0,.4);

    transform:rotate(2deg);
    transition:.4s;
}

.code-card:hover{
    transform:rotate(0deg) translateY(-8px);
}

.window{
    height:43px;
    border-bottom:1px solid rgba(255,255,255,.07);
    display:flex;
    align-items:center;
    padding:0 15px;
}

.window-dots{
    display:flex;
    gap:6px;
}

.window-dots i{
    width:9px;
    height:9px;
    background:#444;
    border-radius:50%;
}

.window-title{
    margin-left:auto;
    color:#626975;
    font-size:10px;
    font-family:monospace;
}

.code{
    padding:28px;
    font-family:monospace;
    font-size:13px;
    line-height:2;
    color:#c6ccd5;
}

.indent{
    padding-left:25px;
}

.purple{color:#c792ea}
.blue{color:#82aaff}
.green{color:#c3e88d}
.orange{color:#f78c6c}


/* SECTIONS */

section{
    padding:110px 0;
}

.section-title{
    margin-bottom:50px;
}

.section-title .number{
    color:#00ff99;
